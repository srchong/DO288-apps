---
// Layout base: shell HTML compartido por la app.
// El idioma del documento es español (la interfaz que lee el usuario);
// los audios en portugués son contenido aparte.
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
