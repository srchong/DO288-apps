# Evently — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Project URL and keys from the Supabase dashboard (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 (S3-compatible photo storage) ----------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=evently-photos
# Public base URL of the bucket (custom domain or r2.dev URL), no trailing slash.
R2_PUBLIC_URL=https://photos.example.com

# --- Cloudflare Turnstile (captcha) -----------------------------------------
# Site key is public and used by the browser widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Secret key is server-only, used to verify tokens.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
